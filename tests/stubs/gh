#!/usr/bin/env python3
"""Offline gh stand-in, with per-call fixtures and failure controls.

Each call is logged to GH_STUB_ARGV and answered from GH_STUB_FIXTURES/<kind>.json, where kind is
state (pr view), list (pr list), create (pr create), or reviews, inline or conversation (api).
"""
import json
import os
from pathlib import Path
import sys
import time

args = sys.argv[1:]
with Path(os.environ["GH_STUB_ARGV"]).open("a") as log:
    log.write(json.dumps(args) + "\n")
commands = {("pr", "view"): "state", ("pr", "list"): "list", ("pr", "create"): "create"}
kind = commands.get(tuple(args[:2])) or (
    "reviews" if args[1].endswith("/reviews") else "inline" if "/pulls/" in args[1] else "conversation")
if os.environ.get("GH_STUB_FAIL") == kind:
    sys.stderr.write(os.environ.get("GH_STUB_ERROR", "stub gh: authentication failed") + "\n")
    sys.exit(1)
if os.environ.get("GH_STUB_SLEEP") == kind:
    time.sleep(float(os.environ.get("GH_STUB_SECONDS", "2")))
sys.stdout.write((Path(os.environ["GH_STUB_FIXTURES"]) / f"{kind}.json").read_text())
