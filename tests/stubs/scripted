#!/usr/bin/env python3
"""Stand-in for the claude and codex CLIs that follows a plan chosen by the test.

STUB_PLAN is a JSON list; each invocation takes the next entry:
  {"sh": "<shell run in the working directory>", "reply": "<transition>", "exit": <code>}
The prompt is saved to STUB_PROMPTS/<n>-<engine>.txt and what the shell printed to <n>-<engine>.out.
STUB_PLAN may instead map a word from an item's title to that item's own list, so items run in parallel
each take their entries in order; files are then named <word>-<n>-<engine>.
With no entry left the stub exits 97.
"""
import json
import os
import pathlib
import subprocess
import sys

engine = pathlib.Path(sys.argv[0]).name
prompts = pathlib.Path(os.environ["STUB_PROMPTS"])
prompts.mkdir(parents=True, exist_ok=True)
plan = json.loads(pathlib.Path(os.environ["STUB_PLAN"]).read_text())
prefix = ""
if isinstance(plan, dict):
    word = next((word for word in plan if word in sys.argv[2]), None)
    if word is None:
        sys.exit(96)
    plan, prefix = plan[word], f"{word}-"
number = len(list(prompts.glob(f"{prefix}[0-9]*.txt"))) + 1
(prompts / f"{prefix}{number:02d}-{engine}.txt").write_text(sys.argv[2])
if number > len(plan):
    sys.exit(97)
entry = plan[number - 1]
if entry.get("sh"):
    with open(prompts / f"{prefix}{number:02d}-{engine}.out", "w") as output:
        subprocess.run(entry["sh"], shell=True, check=False, stdout=output, stderr=subprocess.STDOUT)
reply = f"Done.\nTRANSITION: {entry['reply']}" if entry.get("reply") else "No transition."
if engine == "claude":
    print(json.dumps({"type": "result", "subtype": "success", "result": reply}))
else:
    print(reply)
sys.exit(entry.get("exit", 0))
