{
  "initial": "captured",
  "steps": {
    "captured":  {"owner": "human",             "transitions": {"analyse": "analysis"}},
    "analysis":  {"owner": "agent:analyst",     "transitions": {"questions": "answering", "analysed": "challenge"}},
    "challenge": {"owner": "agent:challenger",  "transitions": {"sound": "ready", "rework": "analysis"}},
    "answering": {"owner": "human",             "transitions": {"answered": "analysis"}},
    "ready":     {"owner": "human",             "transitions": {"play": "implement", "rework": "analysis"}},
    "implement": {"owner": "agent:implementer", "transitions": {"implemented": "test"}},
    "test":      {"owner": "agent:tester",      "transitions": {"written": "verify", "defect": "implement"}},
    "verify":    {"owner": "check",             "transitions": {"passed": "review", "failed": "test"}},
    "review":    {"owner": "agent:reviewer",    "transitions": {"approve": "accept", "revise": "implement"}},
    "accept":    {"owner": "human",             "transitions": {"pr": "publish", "accept": "done", "revise": "implement"}},
    "publish":   {"owner": "agent:publisher",   "transitions": {"published": "done"}},
    "done":      {"owner": "human",             "transitions": {}}
  }
}
