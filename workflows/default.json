{
  "initial": "captured",
  "steps": {
    "captured": {"owner": "human", "transitions": {"analyse": "analysis"}},
    "analysis": {"owner": "agent:analyst", "transitions": {"questions": "answering", "analysed": "challenge"}},
    "challenge": {"owner": "agent:challenger", "transitions": {"sound": "ready", "rework": "analysis"}},
    "answering": {"owner": "human", "transitions": {"answered": "analysis"}},
    "ready": {"owner": "human", "transitions": {"play": "implement", "rework": "analysis"}},
    "implement": {"owner": "agent:implementer", "transitions": {"implemented": "test", "blocked": "ready"}},
    "test": {"owner": "agent:tester", "transitions": {"written": "sync", "defect": "implement"}},
    "sync": {"owner": "harness:sync", "transitions": {"completed": "verify", "conflicted": "resolve"}},
    "resolve": {"owner": "agent:implementer", "transitions": {"resolved": "verify", "blocked": "ready"}},
    "verify": {"owner": "check", "transitions": {"passed": "review", "failed": "test"}},
    "review": {"owner": "agent:reviewer", "transitions": {"approve": "accept", "revise": "implement"}},
    "accept": {"owner": "human", "transitions": {"pr": "sync-publish", "revise": "implement", "abandon": "abandoning"}},
    "sync-publish": {"owner": "harness:sync", "transitions": {"completed": "verify-publish", "conflicted": "resolve-publish"}},
    "resolve-publish": {"owner": "agent:implementer", "transitions": {"resolved": "verify-publish", "blocked": "ready"}},
    "verify-publish": {"owner": "check", "transitions": {"passed": "publish", "failed": "implement"}},
    "publish": {"owner": "agent:publisher", "transitions": {"published": "pull-request"}},
    "pull-request": {"owner": "human", "transitions": {"merged": "merged", "rejected": "rejected", "abandon": "abandoning"}},
    "merged": {"owner": "harness:merged", "transitions": {"completed": "done"}},
    "rejected": {"owner": "harness:rejected", "transitions": {"completed": "implement"}},
    "abandoning": {"owner": "harness:abandon", "transitions": {"completed": "abandoned"}},
    "abandoned": {"owner": "human", "transitions": {}},
    "done": {"owner": "human", "transitions": {}}
  }
}
